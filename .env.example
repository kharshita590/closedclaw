AGENT_URL=http://agent:8000
BROWSER_SANDBOX_URL=http://browser-sandbox:8000
SECRETS_DIR=secrets
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json
OAUTH_PORT=8765

# Primary API key accepted by the agent, UI, bridges, and browser sandbox; use a long random value.
AGENT_API_KEY=
# Comma-separated list of additional accepted agent API keys for rotation.
AGENT_API_KEYS=
# Browser sandbox API key; leave empty to reuse AGENT_API_KEY/AGENT_API_KEYS.
BROWSER_SANDBOX_API_KEY=

# Maximum characters of browser-sourced text/summary surfaced to users (default: 8000).
BROWSER_CONTENT_MAX_CHARS=8000

# Comma-separated list of enabled channels/bridges (default: ui,telegram).
ENABLED_CHANNELS=ui,telegram

# WhatsApp sidecar REST URL (default: http://whatsapp-sidecar:8085).
WHATSAPP_SIDECAR_URL=http://whatsapp-sidecar:8085

# WhatsApp bridge URL used by the Node sidecar to forward inbound messages (default: http://whatsapp-bridge:8080).
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:8080

# Discord bot token for the Discord bridge.
DISCORD_BOT_TOKEN=

# Signal CLI REST API URL and configured sender number for Signal bridge.
SIGNAL_CLI_REST_URL=http://signal-cli-rest-api:8080
SIGNAL_SENDER_NUMBER=

# Skills directory (default: ~/.closedclaw/skills).
SKILLS_DIR=~/.closedclaw/skills
# Allow low-risk skills to execute without human approval (default: false).
ALLOW_AUTONOMOUS_LOW_RISK_SKILLS=false

# Scheduled actions (cron) - stored in PostgreSQL.
# Cron expressions currently support '* * * * *' and '*/N * * * *' minute steps.
# (Celery beat checks every minute.)

# Max planning steps allowed (default: 8, max: 12).
PLAN_STEP_HARD_LIMIT=8

# Pairing code lifetime in seconds before unknown channel senders must request a new code.
PAIRING_CODE_TTL_SECONDS=600

# Policy limits.
# Comma-separated recipient domains allowed for outbound email; empty allows all domains.
ALLOWED_EMAIL_DOMAINS=
# Comma-separated domains blocked for browser navigation.
BLOCKED_URL_DOMAINS=paypal.com,stripe.com,adult.example,phishing.example
# Maximum outbound email body length in characters.
MAX_EMAIL_BODY_CHARS=10000
# Maximum serialized typed action payload size in bytes.
MAX_ACTION_PAYLOAD_BYTES=20000
# Maximum executions of one action type per hour.
ACTION_RATE_LIMIT_PER_HOUR=10
# Maximum number of ordered tool steps the supervisor execution loop will run for one user message.
EXECUTION_LOOP_MAX_STEPS=5

# PostgreSQL database URL for approvals, memory, pairing, and allowlists.
DATABASE_URL=postgresql://closedclaw:closedclaw@postgres:5432/closedclaw

# Redis broker URL for Celery background approval execution.
CELERY_BROKER_URL=redis://redis:6379/0

# Optional OTLP endpoint for tracing, e.g. http://jaeger:4317 in Docker.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# LLM routing and general responses.
# Use "none" for deterministic rule routing, "api" for OpenAI-compatible APIs,
# or "ollama" for a local Ollama server.
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1

# For Docker Desktop on macOS, host.docker.internal reaches Ollama running on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
