AGENT_URL=http://agent:8000
BROWSER_SANDBOX_URL=http://browser-sandbox:8000
SECRETS_DIR=secrets
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json
OAUTH_PORT=8765

# LLM routing and general responses.
# Use "none" for deterministic rule routing, "api" for OpenAI-compatible APIs,
# or "ollama" for a local Ollama server.
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1

# For Docker Desktop on macOS, host.docker.internal reaches Ollama running on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
