AGENT_URL=http://agent:8000
BROWSER_SANDBOX_URL=http://browser-sandbox:8000
SECRETS_DIR=secrets
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json
OAUTH_PORT=8765

# API authentication. Use a long random value and reuse it for UI/bridges.
AGENT_API_KEY=
AGENT_API_KEYS=
BROWSER_SANDBOX_API_KEY=

# Channel pairing and allowlist policy.
CHANNEL_POLICY_PATH=channel_policy.yaml
PAIRING_DB_PATH=memory/pairing_requests.db
PAIRING_CODE_TTL_SECONDS=600

# Policy limits.
ALLOWED_EMAIL_DOMAINS=
BLOCKED_URL_DOMAINS=paypal.com,stripe.com,adult.example,phishing.example
MAX_EMAIL_BODY_CHARS=10000
MAX_ACTION_PAYLOAD_BYTES=20000
ACTION_RATE_LIMIT_PER_HOUR=10

# LLM routing and general responses.
# Use "none" for deterministic rule routing, "api" for OpenAI-compatible APIs,
# or "ollama" for a local Ollama server.
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1

# For Docker Desktop on macOS, host.docker.internal reaches Ollama running on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
